---
import { Picture } from 'astro:assets';
import heroPhoto from '~/assets/photos/hero-jump.avif';

// TODO: confirm the 100% graduation figure (and its cohort) and the 25-year
// tenure with the Dallas Tennis Association before launch.
const stats = [
  { figure: '1,000+', label: 'kids served each year' },
  { figure: '100%', label: 'of senior players accepted to college' },
  { figure: '25 years', label: 'of free programs at Kiest' },
];
---

<section
  class="relative isolate flex min-h-svh flex-col overflow-hidden bg-night text-line"
>
  <Picture
    src={heroPhoto}
    alt="Young players and coaches leap into the air with rackets raised on a blue tennis court."
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-[58%_50%]"
  />
  {/* Navy wash: darkest behind the headline (top left) and the details (bottom), clear over the kids. */}
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-night/50 bg-[linear-gradient(to_bottom,rgb(20_41_74/0.8),transparent_30%,transparent_45%,rgb(20_41_74/0.95)),linear-gradient(to_right,rgb(20_41_74/0.9),rgb(20_41_74/0.6)_40%,transparent_70%)] lg:bg-night/15"
  >
  </div>

  <div class="page-container flex flex-1 flex-col justify-between gap-16 pt-32 pb-10 sm:pt-36 lg:pb-12">
    <div class="max-w-3xl 2xl:max-w-4xl">
      <h1
        class="font-display text-[3.25rem] leading-[0.92] font-extrabold tracking-tight uppercase [font-stretch:72%] sm:text-7xl lg:text-[5.5rem] 2xl:text-[6.75rem]"
      >
        At Kiest, tennis belongs to <span class="whitespace-nowrap text-ball">every kid.</span>
      </h1>

      <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a
          href="/take-action"
          class="rounded-full bg-ball px-7 py-3.5 font-bold tracking-wide text-night uppercase [font-stretch:85%] shadow-lg shadow-black/25 transition hover:bg-[#e6f56b]"
        >
          Speak up for Kiest kids
        </a>
        <a
          href="#where-things-stand"
          class="rounded-full bg-night/50 px-7 py-3.5 font-bold tracking-wide uppercase [font-stretch:85%] ring-2 ring-line/70 backdrop-blur-sm transition hover:bg-night/80 hover:ring-line"
        >
          See where things stand
        </a>
      </div>
      <p class="mt-5 text-base font-medium text-line [text-shadow:0_1px_3px_rgb(0_0_0/0.6)]">
        The city now expects the new contract this winter. There’s still time to be heard.
      </p>
    </div>

    <div class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
      <p class="max-w-xl font-serif text-lg leading-relaxed text-pretty text-line [text-shadow:0_1px_3px_rgb(0_0_0/0.5)]">
        For decades, Kiest Tennis Center has been home to tennis in Oak Cliff and South Dallas. Today,
        through the Dallas Tennis Association, more than 1,000 kids a year, from the neighborhood and across
        the city, learn and play here for free. Whoever runs the center next, we’re&nbsp;staying.
      </p>

      <dl
        class="grid w-full shrink-0 grid-cols-3 divide-x divide-line/20 rounded-2xl bg-night/65 py-4 ring-1 ring-line/20 backdrop-blur-sm sm:w-fit"
      >
        {
          stats.map(({ figure, label }) => (
            <div class="flex flex-col-reverse justify-end px-3 sm:px-6">
              <dt class="mt-1 max-w-[10.5rem] text-[0.8125rem] leading-snug text-line/85 sm:text-sm">{label}</dt>
              <dd class="text-xl font-extrabold whitespace-nowrap text-ball [font-stretch:78%] sm:text-3xl">{figure}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
