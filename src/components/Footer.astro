---
import { site } from '~/site.config';

// Links left blank in site.config are left out rather than pointing nowhere.
const social = [
  { label: 'Instagram', href: site.links.instagram },
  { label: 'Facebook', href: site.links.facebook },
  { label: 'TikTok', href: site.links.tiktok },
].filter(({ href }) => href);

const email = site.links.email;
const year = new Date().getFullYear();
---

<footer class="bg-night text-line">
  <div class="page-container grid gap-12 py-16 sm:grid-cols-2 sm:py-20 lg:grid-cols-[minmax(0,2fr)_repeat(2,minmax(0,1fr))] lg:gap-16">
    <div class="max-w-sm sm:col-span-2 lg:col-span-1">
      <a href="/" aria-label="Rally for Kiest, home" class="inline-block">
        <img src="/logo.png" alt="" width="492" height="373" loading="lazy" class="h-20 w-auto" />
      </a>
      <p class="mt-5 font-serif leading-relaxed text-pretty text-line/80">
        A community coalition keeping Kiest Tennis Center free and open to every kid, whoever holds the
        contract.
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-sm font-semibold text-line/60">Pages</h2>
      <ul class="mt-4 grid gap-2.5">
        <li><a href="/" class="font-semibold hover:text-ball">Home</a></li>
        {
          site.nav.map(({ href, label }) => (
            <li>
              <a href={href} class="font-semibold hover:text-ball">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold text-line/60">Get involved</h2>
      <ul class="mt-4 grid gap-2.5">
        {
          site.links.petition && (
            <li>
              <a href={site.links.petition} target="_blank" rel="noopener" class="font-semibold hover:text-ball">
                Sign the petition<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          )
        }
        {
          email && (
            <li>
              <a href={`mailto:${email}`} class="font-semibold hover:text-ball">
                Email the coalition
              </a>
            </li>
          )
        }
        {
          social.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener" class="font-semibold hover:text-ball">
                {label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line/10">
    <div class="page-container flex flex-col gap-2 py-6 text-sm text-line/60 md:flex-row md:justify-between md:gap-8">
      <p>
        © {year} {site.name}. An independent community coalition, not affiliated with the City of Dallas or the
        Dallas Tennis Association.
      </p>
      <p class="shrink-0">
        Site by{' '}
        {
          site.credit.url ? (
            <a href={site.credit.url} target="_blank" rel="noopener" class="font-semibold text-line/80 hover:text-ball">
              {site.credit.name}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : (
            <span class="font-semibold text-line/80">{site.credit.name}</span>
          )
        }
      </p>
    </div>
  </div>
</footer>
