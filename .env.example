# Where the "Join the coalition" form posts. Any endpoint that accepts a
# form POST and returns JSON works (Formspree, Basin, a Netlify/Cloudflare
# function, or your own API). Leave blank and the form shows a setup notice.
PUBLIC_SIGNUP_ENDPOINT=

# Canonical site URL, used for the sitemap and social tags.
SITE_URL=https://rallyforkiest.org
